  periodEnd        DateTime? @map("period_end")
  status           String    @default("PENDING")
  recordsProcessed Int       @default(0) @map("records_processed")
  durationMs       Int?      @map("duration_ms")
  errorMessage     String?   @map("error_message")
  metadata         Json?
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([jobType])
  @@index([scope, targetId])
  @@index([status])
  @@index([createdAt])
  @@map("analytics_job_runs")
}

model Report {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  coachId        String?       @map("coach_id")
  userId         String?       @map("user_id")
  creatorId      String        @map("creator_id")
  reportType     String        @map("report_type")
  format         String        @default("CSV")
  scope          String
  dateRangeStart DateTime      @map("date_range_start")
  dateRangeEnd   DateTime      @map("date_range_end")
  filters        Json?
  status         String        @default("PENDING")
  fileKey        String?       @map("file_key")
  fileUrl        String?       @map("file_url")
  expiresAt      DateTime?     @map("expires_at")
  errorMessage   String?       @map("error_message")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  creator        User          @relation("ReportCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([organizationId])
  @@index([coachId])
  @@index([userId])
  @@index([reportType])
  @@index([status])
  @@map("reports")
}


