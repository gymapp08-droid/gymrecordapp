datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ATHLETE
  COACH
  TRAINER
  NUTRITIONIST
  ORG_ADMIN
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
  DECLINED
}

enum ClientStatus {
  ACTIVE
  INVITED
  INACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum PrimaryGoal {
  HYPERTROPHY
  STRENGTH
  FAT_LOSS
  ENDURANCE
  LONGEVITY
  GENERAL_FITNESS
}

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum HealthPlatform {
  APPLE_HEALTHKIT
  ANDROID_HEALTH_CONNECT
  GARMIN
  WHOOP
  OURA
}

enum HealthConnectionStatus {
  CONNECTED
  DISCONNECTED
  REVOKED
  PENDING_PERMISSION
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ASSIGNED
  ARCHIVED
}

enum NotificationCategory {
  WORKOUT
  NUTRITION
  HYDRATION
  ACTIVITY
  PROGRESS
  GOALS
  MESSAGES
  COACH
  SYSTEM
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  PUSH
  IN_APP
  EMAIL
}

// -------------------------------------------------------------
// USER & IDENTITY
// -------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users                       User[]
  relationships               CoachClientRelationship[]
  invitations                 ClientInvitation[]
  analyticsDailyOrganizations AnalyticsDailyOrganization[]
  reports                     Report[]

  @@map("organizations")
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String        @map("password_hash")
  role            UserRole      @default(ATHLETE)
  status          AccountStatus @default(ACTIVE)
  isActive        Boolean       @default(true) @map("is_active")
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  organizationId  String?       @map("organization_id")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // One-to-one relations
  profile         UserProfile?
  preference      UserPreference?
  goal            UserGoal?

  // Auth tokens
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  revokedTokens           RevokedToken[]

  // Domain entities (Explicit user ownership)
  programsCreated         Program[]         @relation("CoachCreatedPrograms")
  assignedPrograms        ProgramAssignment[] @relation("AthleteAssignedPrograms")
  workoutSessions         WorkoutSession[]
  mealPlansCreated        MealPlan[]        @relation("NutritionistCreatedMealPlans")
  assignedMealPlans       MealPlanAssignment[] @relation("AthleteAssignedMealPlans")
  dailyMealLogs           DailyMealLog[]
  hydrationLogs           HydrationLog[]
  bodyMetrics             BodyMetric[]
  bodyMeasurements        BodyMeasurement[]
  personalRecords         PersonalRecord[]
  activityRecords         ActivityRecord[]
  cardioSessions          CardioSession[]
  reminders               Reminder[]
  progressPhotos          ProgressPhoto[]
  notifications           Notification[]
  devices                 Device[]
  notificationPreference  NotificationPreference?
  healthConnections       HealthConnection[]
  auditLogs               AuditLog[]
  aiConversations         AIConversation[]
  aiInsights              AIInsight[]
  aiUsageRecords          AIUsageRecord[]
  sentInvitations         ClientInvitation[]        @relation("CoachSentInvitations")
  weeklyCheckIns          WeeklyCheckIn[]           @relation("UserWeeklyCheckIns")
  reviewedCheckIns        WeeklyCheckIn[]           @relation("ReviewerWeeklyCheckIns")

  // Coach-Client Explicit Relationships
  clientsAsCoach          CoachClientRelationship[] @relation("CoachRelationship")
  coachesAsClient         CoachClientRelationship[] @relation("ClientRelationship")
  calendarEventsAsCoach   CoachCalendarEvent[]      @relation("CoachCalendarEvents")
  calendarEventsAsClient  CoachCalendarEvent[]      @relation("ClientCalendarEvents")
  reportsCreated          CoachingReport[]          @relation("CoachReports")
  coachSentMessages       CoachMessage[]            @relation("CoachSentMessages")
  clientReceivedMessages  CoachMessage[]            @relation("ClientReceivedMessages")
  coachAiDrafts           CoachAiDraft[]            @relation("CoachAiDrafts")
  notesAuthored           TrainerClientNote[]       @relation("AuthorTrainerNotes")
  notesReceived           TrainerClientNote[]       @relation("ClientTrainerNotes")

  // Analytics & Executive Intelligence (Phase 10)
  analyticsDailyUser      AnalyticsDailyUser[]
  analyticsDailyCoach     AnalyticsDailyCoach[]
  generatedReports        Report[]                  @relation("ReportCreator")

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model CoachClientRelationship {
  id             String       @id @default(uuid())
  coachId        String       @map("coach_id")
  clientId       String       @map("client_id")
  organizationId String?      @map("organization_id")
  status         ClientStatus @default(ACTIVE)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  coach          User          @relation("CoachRelationship", fields: [coachId], references: [id], onDelete: Cascade)
  client         User          @relation("ClientRelationship", fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
  @@index([coachId, status, isActive])
  @@index([organizationId, status])
  @@map("coach_client_relationships")
}

model TrainerClientNote {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  clientId  String   @map("client_id")
  note      String
  category  String   @default("GENERAL") // GENERAL, NUTRITION, BIOMECHANICS, COMPLIANCE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation("AuthorTrainerNotes", fields: [authorId], references: [id], onDelete: Cascade)
  client User @relation("ClientTrainerNotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([authorId])
  @@map("trainer_client_notes")
}

model ClientInvitation {
  id             String           @id @default(uuid())
  organizationId String?          @map("organization_id")
  coachId        String           @map("coach_id")
  clientEmail    String           @map("client_email")
  role           UserRole         @default(ATHLETE)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  coach          User             @relation("CoachSentInvitations", fields: [coachId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([clientEmail])
  @@index([token])
  @@map("client_invitations")
}

model UserProfile {
  id                    String           @id @default(uuid())
  userId                String           @unique @map("user_id")
  fullName              String           @map("full_name")
  avatarUrl             String?          @map("avatar_url")
  dateOfBirth           DateTime?        @map("date_of_birth")
  gender                Gender?
  heightCm              Float?           @map("height_cm")
  weightKg              Float?           @map("weight_kg")
  experienceLevel       ExperienceLevel? @map("experience_level")
  activityMultiplier    Float?           @default(1.2) @map("activity_multiplier")
  isOnboardingCompleted Boolean          @default(false) @map("is_onboarding_completed")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  id                       String     @id @default(uuid())
  userId                   String     @unique @map("user_id")
  unitSystem               UnitSystem @default(METRIC) @map("unit_system")
  timezone                 String     @default("UTC") // IANA timezone
  language                 String     @default("en")  // ISO 639-1
  theme                    String     @default("black_glass")
  pushNotificationsEnabled Boolean    @default(true) @map("push_notifications_enabled")
  emailNotificationsEnabled Boolean   @default(true) @map("email_notifications_enabled")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserGoal {
  id                     String      @id @default(uuid())
  userId                 String      @unique @map("user_id")
  primaryGoal            PrimaryGoal @default(HYPERTROPHY) @map("primary_goal")
  targetWeightKg         Float?      @map("target_weight_kg")
  targetDailyCalories    Int?        @map("target_daily_calories")
  targetDailyProteinGrams Int?       @map("target_daily_protein_grams")
  targetDailyCarbsGrams  Int?        @map("target_daily_carbs_grams")
  targetDailyFatGrams    Int?        @map("target_daily_fat_grams")
  targetWeeklyWorkouts   Int?        @default(4) @map("target_weekly_workouts")
  targetDailySteps       Int?        @default(10000) @map("target_daily_steps")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_goals")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("email_verification_tokens")
}

model RevokedToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime @default(now()) @map("revoked_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("revoked_tokens")
}

// -------------------------------------------------------------
// WORKOUT & TRAINING DOMAIN
// (Strict separation: Program Template -> Assigned Program -> Workout Session -> Execution)
// -------------------------------------------------------------

model Exercise {
  id               String   @id @default(uuid())
  name             String   @unique
  category         String
  primaryMuscle    String   @map("primary_muscle")
  secondaryMuscles String[] @default([]) @map("secondary_muscles")
  targetArea       String?  @map("target_area")
  equipment        String   @default("Barbell")
  movementPattern  String?  @map("movement_pattern")
  exerciseType     String?  @default("STRENGTH") @map("exercise_type")
  difficulty       String   @default("INTERMEDIATE")
  description      String?
  instructions     String?
  technique        String?
  commonMistakes   String?  @map("common_mistakes")
  safetyNotes      String?  @map("safety_notes")
  tempo            String?
  defaultRest      Int      @default(90) @map("default_rest")
  tags             String[] @default([])
  status           String   @default("ACTIVE")
  animationUrl     String?  @map("animation_url")
  imageUrl         String?  @map("image_url")
  videoUrl         String?  @map("video_url")
  thumbnailUrl     String?  @map("thumbnail_url")
  isCustom         Boolean  @default(false) @map("is_custom")
  creatorId        String?  @map("creator_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  templateExercises WorkoutTemplateExercise[]
  sessionExercises  WorkoutSessionExercise[]

  @@index([primaryMuscle])
  @@index([equipment])
  @@index([status])
  @@map("exercises")
}

model Program {
  id              String        @id @default(uuid())
  creatorId       String        @map("creator_id")
  name            String
  description     String?
  isTemplate      Boolean       @default(true) @map("is_template")
  weeksCount      Int           @default(4) @map("weeks_count")
  status          ProgramStatus @default(DRAFT)
  version         Int           @default(1)
  parentProgramId String?       @map("parent_program_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  creator     User     @relation("CoachCreatedPrograms", fields: [creatorId], references: [id], onDelete: Cascade)
  days        ProgramDay[]
  assignments ProgramAssignment[]

  @@index([creatorId])
  @@index([status])
  @@map("programs")
}

model ProgramDay {
  id          String   @id @default(uuid())
  programId   String   @map("program_id")
  dayOfWeek   Int      @map("day_of_week") // 1 (Mon) - 7 (Sun)
  weekNumber  Int      @default(1) @map("week_number")
  title       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  templates   WorkoutTemplate[]

  @@index([programId])
  @@map("program_days")
}

model WorkoutTemplate {
  id           String   @id @default(uuid())
  programDayId String?  @map("program_day_id")
  name         String
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  programDay   ProgramDay? @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exercises    WorkoutTemplateExercise[]
  sessions     WorkoutSession[]

  @@index([programDayId])
  @@map("workout_templates")
}

model WorkoutTemplateExercise {
  id                String   @id @default(uuid())
  workoutTemplateId String   @map("workout_template_id")
  exerciseId        String   @map("exercise_id")
  orderIndex        Int      @default(0) @map("order_index")
  targetSets        Int      @default(3) @map("target_sets")
  targetReps        Int      @default(10) @map("target_reps")
  targetRpe         Float?   @map("target_rpe")
  restSeconds       Int      @default(90) @map("rest_seconds")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise          Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([workoutTemplateId])
  @@index([exerciseId])
  @@map("workout_template_exercises")
}

model ProgramAssignment {
  id        String   @id @default(uuid())
  programId String   @map("program_id")
  athleteId String   @map("athlete_id")
  startDate DateTime @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  athlete   User     @relation("AthleteAssignedPrograms", fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([athleteId])
  @@map("program_assignments")
}

model WorkoutSession {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  workoutTemplateId String?       @map("workout_template_id")
  title             String
  status            WorkoutStatus @default(PLANNED)
  startedAt         DateTime?     @map("started_at")
  completedAt       DateTime?     @map("completed_at")
  durationSeconds   Int           @default(0) @map("duration_seconds")
  totalVolumeKg     Float         @default(0) @map("total_volume_kg")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutTemplate   WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)
  exercises         WorkoutSessionExercise[]

  @@index([userId])
  @@index([workoutTemplateId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status])
  @@map("workout_sessions")
}

model WorkoutSessionExercise {
  id               String   @id @default(uuid())
  workoutSessionId String   @map("workout_session_id")
  exerciseId       String   @map("exercise_id")
  orderIndex       Int      @default(0) @map("order_index")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets             WorkoutSet[]

  @@index([workoutSessionId])
  @@index([exerciseId])
  @@map("workout_session_exercises")
}

model WorkoutSet {
  id                       String   @id @default(uuid())
  workoutSessionExerciseId String   @map("workout_session_exercise_id")
  setNumber                Int      @map("set_number")
  targetReps               Int?     @map("target_reps")
  actualReps               Int?     @map("actual_reps")
  weightKg                 Float?   @map("weight_kg")
  rpe                      Float?
  isCompleted              Boolean  @default(false) @map("is_completed")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  sessionExercise          WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutSessionExerciseId])
  @@map("workout_sets")
}

// -------------------------------------------------------------
// NUTRITION DOMAIN
// -------------------------------------------------------------

model FoodItem {
  id             String   @id @default(uuid())
  name           String
  brand          String?
  barcode        String?  @unique
  servingSizeG   Float    @default(100) @map("serving_size_g")
  servingUnit    String   @default("g") @map("serving_unit")
  calories       Float
  proteinGrams   Float    @map("protein_grams")
  carbsGrams     Float    @map("carbs_grams")
  fatGrams       Float    @map("fat_grams")
  fiberGrams     Float?   @default(0) @map("fiber_grams")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  mealItems      MealItem[]

  @@index([name])
  @@index([barcode])
  @@map("food_items")
}

model MealPlan {
  id           String        @id @default(uuid())
  creatorId    String        @map("creator_id")
  name         String
  description  String?
  isTemplate   Boolean       @default(true) @map("is_template")
  status       ProgramStatus @default(DRAFT)
  version      Int           @default(1)
  parentPlanId String?       @map("parent_plan_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  creator     User     @relation("NutritionistCreatedMealPlans", fields: [creatorId], references: [id], onDelete: Cascade)
  meals       Meal[]
  assignments MealPlanAssignment[]

  @@index([creatorId])
  @@index([status])
  @@map("meal_plans")
}

model MealPlanAssignment {
  id         String   @id @default(uuid())
  mealPlanId String   @map("meal_plan_id")
  athleteId  String   @map("athlete_id")
  startDate  DateTime @map("start_date")
  endDate    DateTime? @map("end_date")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  athlete    User     @relation("AthleteAssignedMealPlans", fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([athleteId])
  @@map("meal_plan_assignments")
}

model Meal {
  id         String   @id @default(uuid())
  mealPlanId String?  @map("meal_plan_id")
  name       String   // e.g., "Breakfast", "Pre-Workout"
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items      MealItem[]

  @@index([mealPlanId])
  @@map("meals")
}

model MealItem {
  id          String   @id @default(uuid())
  mealId      String?  @map("meal_id")
  dailyLogId  String?  @map("daily_log_id")
  foodItemId  String   @map("food_item_id")
  quantity    Float    @default(1)
  totalWeightG Float   @map("total_weight_g")
  calories    Float
  proteinGrams Float   @map("protein_grams")
  carbsGrams  Float    @map("carbs_grams")
  fatGrams    Float    @map("fat_grams")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  meal        Meal?         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  dailyLog    DailyMealLog? @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  foodItem    FoodItem      @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([dailyLogId])
  @@index([foodItemId])
  @@map("meal_items")
}

model DailyMealLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  logDate      DateTime @map("log_date")
  mealType     String   @map("meal_type") // Breakfast, Lunch, Dinner, Snack
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        MealItem[]

  @@index([userId])
  @@index([logDate])
  @@index([userId, logDate])
  @@map("daily_meal_logs")
}

model HydrationLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amountMl  Float    @map("amount_ml")
  logDate   DateTime @map("log_date")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([logDate])
  @@index([userId, logDate])
  @@map("hydration_logs")
}

// -------------------------------------------------------------
// BIOMETRICS, PROGRESS, & ACTIVITY
// -------------------------------------------------------------

model BodyMetric {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  recordedAt       DateTime @map("recorded_at")
  weightKg         Float?   @map("weight_kg")
  bodyFatPercent   Float?   @map("body_fat_percent")
  muscleMassKg     Float?   @map("muscle_mass_kg")
  waterPercent     Float?   @map("water_percent")
  chestCm          Float?   @map("chest_cm")
  waistCm          Float?   @map("waist_cm")
  hipsCm           Float?   @map("hips_cm")
  bicepsCm         Float?   @map("biceps_cm")
  source           String   @default("MANUAL") // MANUAL, APPLE_HEALTH, etc.
