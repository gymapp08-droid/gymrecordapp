{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@alpha/types": ["../../packages/types/src/index"],
      "@alpha/types/*": ["../../packages/types/src/*"],
      "@alpha/utils": ["../../packages/utils/src/index"],
      "@alpha/utils/*": ["../../packages/utils/src/*"],
      "@alpha/validation": ["../../packages/validation/src/index"],
      "@alpha/validation/*": ["../../packages/validation/src/*"],
      "@alpha/database": ["../../packages/database/src/index"],
      "@alpha/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
