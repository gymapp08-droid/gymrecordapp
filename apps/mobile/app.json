{
  "expo": {
    "name": "ALPHA",
    "slug": "alpha-personal-performance-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alpha",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#05070B",
      "resizeMode": "contain"
    },
    "updates": {
      "url": "https://u.expo.dev/8b8e3acd-ebda-4d78-b8fa-c84d8bb079af",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alpha.performance.os",
      "buildNumber": "1",
      "infoPlist": {
        "NSHealthShareUsageDescription": "ALPHA accesses your steps, heart rate, and workouts to personalize your recovery and coaching recommendations.",
        "NSHealthUpdateUsageDescription": "ALPHA writes your workout sessions and active calories to Apple Health.",
        "NSCameraUsageDescription": "ALPHA uses your camera to capture progress photos.",
        "NSPhotoLibraryUsageDescription": "ALPHA accesses your photo library to select progress photos.",
        "NSLocationWhenInUseUsageDescription": "ALPHA uses your location during outdoor cardio activities to record routes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070B"
      },
      "package": "com.gymapp08.alphapersonalperformanceos",
      "versionCode": 1,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "8b8e3acd-ebda-4d78-b8fa-c84d8bb079af"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}
