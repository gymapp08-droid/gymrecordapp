# Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Security & JWT
JWT_ACCESS_SECRET=alpha_dev_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=alpha_dev_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database (PostgreSQL)
DATABASE_URL=postgresql://alpha_user:alpha_password@localhost:5432/alpha_db?schema=public

# Cache & Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=alpha-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Mobile App
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
